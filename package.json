{
  "name": "orivon",
  "productName": "Orivon Browser",
  "private": true,
  "version": "0.94.1",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "clean": "rm -rf dist out server.js",
    "lint": "tsc -p tsconfig.web.json --noEmit"
  },
  "build": {
    "appId": "com.orivon.browser",
    "productName": "Orivon",
    "directories": { "output": "release" },
    "files": ["out/**/*"],
    "mac":     { "target": "dmg",   "category": "public.app-category.utilities" },
    "win":     { "target": "nsis"  },
    "linux":   { "target": "AppImage" }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-store": "^11.0.2",
    "electron-vite": "^5.0.0",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
